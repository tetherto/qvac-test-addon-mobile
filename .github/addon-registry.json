{
  "$schema": "./addon-registry.schema.json",
  "description": "Registry of compatible addons to test against qvac-test-addon-mobile framework changes",
  "version": "1.1.0",
  "addons": [
    {
      "name": "@qvac/llm-llamacpp",
      "repository": "tetherto/qvac",
      "branch": "main",
      "workdir": "packages/llm-llamacpp",
      "testPath": "test/mobile",
      "hasIntegrationTests": true,
      "prebuildArtifactPrefix": "llama-cpp-",
      "description": "LLM inference addon using llama.cpp",
      "priority": "high",
      "platforms": ["Android", "iOS"]
    },
    {
      "name": "@qvac/transcription-whispercpp",
      "repository": "tetherto/qvac",
      "branch": "main",
      "workdir": "packages/transcription-whispercpp",
      "testPath": "test/mobile",
      "hasIntegrationTests": true,
      "prebuildArtifactPrefix": "whisper-cpp-",
      "description": "Transcription addon using whisper.cpp",
      "priority": "high",
      "platforms": ["Android", "iOS"]
    },
    {
      "name": "@qvac/tts-onnx",
      "repository": "tetherto/qvac",
      "branch": "main",
      "workdir": "packages/tts-onnx",
      "testPath": "test/mobile",
      "hasIntegrationTests": true,
      "prebuildArtifactPrefix": "onnx-tts-",
      "description": "Text-to-speech addon using ONNX runtime",
      "priority": "high",
      "platforms": ["Android", "iOS"]
    },
    {
      "name": "@qvac/translation-nmtcpp",
      "repository": "tetherto/qvac",
      "branch": "main",
      "workdir": "packages/translation-nmtcpp",
      "testPath": "test/mobile",
      "hasIntegrationTests": true,
      "prebuildArtifactPrefix": "nmt-cpp-",
      "description": "Neural machine translation addon using Marian NMT",
      "priority": "high",
      "platforms": ["Android", "iOS"]
    },
    {
      "name": "@qvac/decoder-audio",
      "repository": "tetherto/qvac",
      "branch": "main",
      "workdir": "packages/decoder-audio",
      "testPath": "test/mobile",
      "hasIntegrationTests": true,
      "prebuildArtifactPrefix": "decoder-audio-",
      "description": "Audio decoder addon using FFmpeg",
      "priority": "high",
      "platforms": ["Android", "iOS"]
    }
  ],
  "testSettings": {
    "bundleId": "io.tether.test.qvac",
    "timeoutMinutes": 120,
    "deviceFarmRegion": "us-west-2"
  }
}

